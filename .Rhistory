calculate_pagerank_power <- function(P, beta) {
N <- nrow(P)
J <- matrix(1/N, nrow = N, ncol = N)
G <- beta * P + (1 - beta) * J
pi <- rep(1/N, N)
for(i in 1:1000) {
prev_pi <- pi
pi <- pi %*% G}
return(as.vector(pi))}

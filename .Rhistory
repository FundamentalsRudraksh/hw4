library(readr) # Load the package for future use
library(dplyr) # Load the package for future use
library(tidyr) # Load the package for future use
infant <- read_csv("infant_mortality_rate.csv") # Read/ Load the infant mortality csv
life <- read_csv("life_expectancy_at_birth.csv") # Read/ Load the infant mortality csv
maternal <- read_csv("maternal_mortality_ratio.csv") # Read/ Load the infant mortality csv
infant <- infant %>% rename(infant_mortality = variable) # Rename the variable column to something that makes more sense
life <- life %>% rename(life_expectancy = variable) # Rename the variable column to something that makes more sense
maternal <- maternal %>% rename(maternal_mortality = variable) # Rename the variable column to something that makes more sense
merged_data <- infant %>% select(country, region, infant_mortality) %>%
left_join(life %>% select(country, life_expectancy), by = "country") %>%
left_join(maternal %>% select(country, maternal_mortality), by = "country")
write_csv(merged_data, "merged.csv")
merging_check <- read_csv("merged.csv")
str(merging_check)
aggregate_region <- merged_data %>% group_by(region) %>%
summarise(avg_infant_mortality = mean(infant_mortality, na.rm = TRUE),
avg_life_expectancy = mean(life_expectancy, na.rm = TRUE),
avg_maternal_mortality = mean(maternal_mortality, na.rm = TRUE))
write_csv(aggregate_region, "aggregate_region.csv")
checking_region <- read_csv("aggregate_region.csv")
str(checking_region)
long_data <- long_merged_data %>% pivot_longer(
cols = c(infant_mortality, life_expectancy, maternal_mortality),
names_to = "indicator", values_to = "value")
long_data <- merged_data %>% pivot_longer(
cols = c(infant_mortality, life_expectancy, maternal_mortality),
names_to = "indicator", values_to = "value")
View(long_data)
View(merged_data)
View(merged_data)
long_data <- merged_data %>% pivot_longer(
cols = c(infant_mortality, life_expectancy, maternal_mortality),
names_to = "indicator variable", values_to = "value")
long_data <- merged_data %>%
select(-region) %>%
pivot_longer(
cols = c(infant_mortality, life_expectancy, maternal_mortality),
names_to = "indicator variable", values_to = "value")
View(long_data)
long_data <- merged_data %>%
pivot_longer(
cols = c(infant_mortality, life_expectancy, maternal_mortality),
names_to = "indicator variable", values_to = "value")
View(long_data)
long_data <- merged_data %>%
pivot_longer(
cols = c(infant_mortality, life_expectancy, maternal_mortality),
names_to = "indicator variable", values_to = "value")
write_csv(long_data, "long_format_merged_data.csv")
